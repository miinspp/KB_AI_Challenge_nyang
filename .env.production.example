# docker-compose.yml 이 루트 .env 를 자동으로 읽는다. 실제 배포 시 이 파일을 .env 로 복사하고
# 값을 채운 뒤(.env 는 gitignore 대상, 커밋 금지) `docker compose up -d --build` 실행.

# ── 조합 분석 AI(추천서비스 /api/portfolio) ──
ANTHROPIC_API_KEY=
PORTFOLIO_ADVISOR_MODEL=claude-sonnet-5

# ── CORS: 실제 배포 도메인으로 제한(쉼표로 여러 개 가능, https 포함) ──
# 예: https://nyang.example.com,https://www.nyang.example.com
APP_CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS=

# ── (선택) 파인튜닝 임베딩 모델(ko-sroberta-reco, ~423MB)을 S3에서 받아오려면 ──
# 미설정 시 컨테이너가 bge-m3 공개모델로 자동 폴백(최초 기동 시 ~2GB 다운로드, 정확도는 낮아질 수 있음).
# EC2 인스턴스 프로필에 해당 버킷 s3:GetObject 권한이 있어야 함.
# MODEL_S3_URI=s3://<bucket>/ko-sroberta-reco

# ── pipeline 배치 스크립트용(런타임 서비스에는 불필요, 크론으로 데이터 갱신할 때만) ──
# SEOUL_OPENAPI_KEY=
